#ifdef VERTEX
#version 410
#extension GL_ARB_explicit_attrib_location : require

in  vec4 in_POSITION0;
void main()
{
    gl_Position = in_POSITION0;
    return;
}

#endif
#ifdef FRAGMENT
#version 410
#extension GL_ARB_explicit_attrib_location : require

layout(location = 0) in  float gs_TEXCOORD0;
layout(location = 0) out vec4 SV_Target0;
void main()
{
    SV_Target0 = vec4(gs_TEXCOORD0);
    return;
}

#endif
#ifdef GEOMETRY
#version 410
#extension GL_ARB_explicit_attrib_location : require

#define HLSLCC_ENABLE_UNIFORM_BUFFERS 1
#if HLSLCC_ENABLE_UNIFORM_BUFFERS
#define UNITY_UNIFORM
#else
#define UNITY_UNIFORM uniform
#endif
#define UNITY_SUPPORTS_UNIFORM_LOCATION 1
#if UNITY_SUPPORTS_UNIFORM_LOCATION
#define UNITY_LOCATION(x) layout(location = x)
#define UNITY_BINDING(x) layout(binding = x, std140)
#else
#define UNITY_LOCATION(x)
#define UNITY_BINDING(x) layout(std140)
#endif
uniform 	vec4 hlslcc_mtx4x4unity_MatrixVP[4];
uniform 	float _Extrude;
int u_xlati0;
vec4 u_xlat1;
vec3 u_xlat2;
bool u_xlatb2;
layout(triangles) in;
layout(triangle_strip) out;
layout(location = 0) out float gs_TEXCOORD0;
layout(max_vertices = 3) out;
void main()
{
    for(int u_xlati_loop_1 = 0 ; u_xlati_loop_1<3 ; u_xlati_loop_1++)
    {
        u_xlat2.xyz = gl_in[u_xlati_loop_1].gl_Position.xzw;
        u_xlat1.x = _Extrude + gl_in[u_xlati_loop_1].gl_Position.y;
        u_xlat1 = u_xlat1.xxxx * hlslcc_mtx4x4unity_MatrixVP[1];
        u_xlat1 = hlslcc_mtx4x4unity_MatrixVP[0] * u_xlat2.xxxx + u_xlat1;
        u_xlat1 = hlslcc_mtx4x4unity_MatrixVP[2] * u_xlat2.yyyy + u_xlat1;
        u_xlat1 = hlslcc_mtx4x4unity_MatrixVP[3] * u_xlat2.zzzz + u_xlat1;
        u_xlat2.x = float(u_xlati_loop_1);
        u_xlat2.x = u_xlat2.x * 0.5;
        gl_Position = u_xlat1;
        gs_TEXCOORD0 = u_xlat2.x;
        EmitVertex();
    }
    return;
}

#endif
